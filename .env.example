# Kopieren nach .env und ausfüllen. Die .env gehört nicht ins Git.
# Zufällige Werte erzeugen: openssl rand -hex 24
# Kommentare stehen nur in eigenen Zeilen: Docker Compose und Portainer lesen Text hinter einem Wert
# unterschiedlich. Eine Zeile "NAME=Wert" bleibt deshalb immer ohne Zusatz.

# --- Version des Images ---
# Welche Version des Pakets gestartet wird (Update: hier erhöhen, dann `docker compose pull && docker compose up -d`).
# Ohne Eintrag gilt die Version, mit der diese Compose-Datei ausgeliefert wurde.
# PRTG_GRAFANA_VERSION=0.3.3

# --- Grafana ---
# Port der Weboberfläche
GRAFANA_PORT=3000
# 0.0.0.0 = im Netz erreichbar, 127.0.0.1 = nur auf dem Server selbst (zum Beispiel hinter einem Proxy)
GRAFANA_BIND=0.0.0.0
# Pflicht
GRAFANA_ADMIN_PASSWORD=

# --- InfluxDB ---
# Pflicht
INFLUX_ADMIN_PASSWORD=
# Pflicht, mindestens 32 Zeichen
INFLUX_ADMIN_TOKEN=
INFLUX_ORG=netmon24
# Aufbewahrung der Messwerte in Tagen
INFLUX_RETENTION_DAYS=365
# 127.0.0.1 = nur intern, 0.0.0.0 = auch von außen erreichbar
INFLUX_BIND=127.0.0.1
INFLUX_PORT=8086

# --- Administrationsportal ---
PORTAL_PORT=8088
# 127.0.0.1 = nur auf dem Server selbst; 0.0.0.0 öffnet das Portal im Netz (dann TLS oder Proxy davor)
PORTAL_BIND=127.0.0.1
PORTAL_ADMIN_USER=admin
# true nur hinter einem eigenen Proxy, der X-Forwarded-For setzt: Die Anmeldesperre gilt dann je Besucheradresse
PORTAL_TRUST_PROXY=false
# Pflicht, mindestens 12 Zeichen (später im Portal änderbar)
PORTAL_ADMIN_PASSWORD=
# Pflicht, mindestens 16 Zeichen; verschlüsselt die API-Keys.
# NICHT mehr ändern, sonst sind gespeicherte API-Keys unlesbar.
PORTAL_SECRET_KEY=

LOG_LEVEL=INFO

# --- TLS für InfluxDB, Grafana und Portal (optional) ---
# Betriebsart je Dienst (http, eigenes Zertifikat, Let's Encrypt) stellen Sie im Portal ein (Seite „Zertifikate“).
# Die Dienste erkennen sie selbst; hier ist normalerweise nichts zu tun.
# Nur einkommentieren und setzen, wenn die Verbindung zwischen den Containern anders laufen soll
# (ohne Eintrag gilt automatisch http oder https je nach Betriebsart):
# INFLUX_INTERNAL_URL=
# GRAFANA_INTERNAL_URL=
# Ohne Eintrag: bei TLS ohne Prüfung im Compose-Netz. true = Zertifikat prüfen.
# INTERNAL_TLS_VERIFY=

# --- Let's Encrypt (ACME) ---
# Das Portal besorgt Zertifikate selbst (Seite „Zertifikate“). Voraussetzung: Port 80 des Servers ist aus dem
# Internet erreichbar und der Name zeigt auf den Server. Ist Port 80 belegt, hier einen anderen Host-Port
# wählen und am Router/der Firewall von 80 darauf weiterleiten.
ACME_HTTP_PORT=80
ACME_HTTP_BIND=0.0.0.0
# Ohne Eintrag gilt Let's Encrypt (Test- oder Produktivumgebung nach Auswahl im Portal).
# ACME_DIRECTORY_URL=
