      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "prtg-influx"
          },
          "query": "from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"prtg_sensor_status\" and r._field == \"status_code\")\n  |> filter(fn: (r) => r.core =~ /^${core:regex}$/)\n  |> filter(fn: (r) => r.prtg_tags =~ /(^|\\|)${tag:regex}(\\||$)/)\n  |> filter(fn: (r) => r.prtg_tags =~ /(^|\\|)${tag2:regex}(\\||$)/)\n  |> filter(fn: (r) => r.prtg_tags =~ /(^|\\|)${tag3:regex}(\\||$)/)\n  |> filter(fn: (r) => r.group =~ /^${group:regex}$/)\n  |> filter(fn: (r) => r.device =~ /^${device:regex}$/)\n  |> duplicate(column: \"_value\", as: \"neu\")\n  |> difference(columns: [\"_value\"])\n  |> filter(fn: (r) => r._value != 0)\n  |> map(fn: (r) => ({r with von: r.neu - r._value}))\n  |> group()\n  |> sort(columns: [\"_time\"], desc: true)\n  |> limit(n: 200)\n  |> keep(columns: [\"_time\", \"core\", \"device\", \"dns_name\", \"sensor\", \"von\", \"neu\"])"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "_time": "Zeit",
              "device": "Gerät",
              "dns_name": "DNS-Name",
              "sensor": "Sensor",
              "core": "Core"
            },
            "indexByName": {
              "_time": 0,
              "device": 1,
              "dns_name": 2,
              "sensor": 3,
              "von": 4,
              "neu": 5,
              "core": 6
            }
          }
        }
