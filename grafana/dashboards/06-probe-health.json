    {
      "id": 4,
      "type": "timeseries",
      "title": "Gesundheit der Probe in Prozent",
      "datasource": {
        "type": "influxdb",
        "uid": "prtg-influx"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "prtg-influx"
          },
          "query": "from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"prtg_channel\" and r._field == \"value\")\n  |> filter(fn: (r) => r.device_id == \"40\" and r.sensor_id == \"1003\")\n  |> filter(fn: (r) => contains(value: r.channel, set: [\"Zustand\"]))\n  |> filter(fn: (r) => r.core =~ /^${core:regex}$/)\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n  |> map(fn: (r) => ({r with reihe: r.core + \" – Probe\"}))\n  |> keep(columns: [\"_time\", \"_value\", \"reihe\"])\n  |> group(columns: [\"reihe\"])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 0,
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 12,
            "showPoints": "never",
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "noValue": "Keine Daten im gewählten Zeitraum",
          "displayName": "${__field.labels.reihe}",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#e5484d",
                "value": null
              },
              {
                "color": "#f2c94c",
                "value": 50
              },
              {
                "color": "#35d763",
                "value": 80
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
