{
  "uid": "prtg-probe-health",
  "title": "Probe- und Core-Health",
  "tags": [
    "netmon24",
    "prtg",
    "probe",
    "health"
  ],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5m",
  "timepicker": {
    "refresh_intervals": [
      "5m",
      "15m",
      "30m",
      "1h"
    ]
  },
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "core",
        "label": "Core",
        "type": "query",
        "datasource": {
          "type": "influxdb",
          "uid": "prtg-influx"
        },
        "query": "import \"influxdata/influxdb/schema\"\nschema.tagValues(bucket: v.defaultBucket, tag: \"core\")",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "sort": 5,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "allValue": ".*"
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "type": "dashboards",
      "title": "Weitere Dashboards",
      "tags": [
        "netmon24"
      ],
      "asDropdown": true,
      "includeVars": true,
      "keepTime": true
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Zustand der Probe (Sensor 1003)",
      "datasource": {
        "type": "influxdb",
        "uid": "prtg-influx"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "prtg-influx"
          },
          "query": "from(bucket: v.defaultBucket)\n  |> range(start: -15m)\n  |> filter(fn: (r) => r._measurement == \"prtg_sensor_status\" and r._field == \"status_code\")\n  |> filter(fn: (r) => r.device_id == \"40\" and r.sensor_id == \"1003\")\n  |> filter(fn: (r) => r.core =~ /^${core:regex}$/)\n  |> last()\n  |> group(columns: [\"core\", \"sensor_id\", \"_field\"])\n  |> top(n: 1, columns: [\"_time\"])\n  |> keep(columns: [\"_time\", \"_value\", \"core\"])\n  |> group(columns: [\"core\"])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "Keine Daten",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#35d763",
                "value": null
              }
            ]
          },
          "decimals": 0,
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "OK",
                  "color": "#35d763",
                  "index": 0
                },
                "1": {
                  "text": "Warnung",
                  "color": "#f2c94c",
                  "index": 1
                },
                "2": {
                  "text": "Ausfall",
                  "color": "#e5484d",
                  "index": 2
                },
                "3": {
                  "text": "Pausiert",
                  "color": "#4aa8ff",
                  "index": 3
                },
                "4": {
                  "text": "Unbekannt",
                  "color": "#8a9ba0",
                  "index": 4
                }
              }
            }
          ],
          "displayName": "${__field.labels.core}"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
